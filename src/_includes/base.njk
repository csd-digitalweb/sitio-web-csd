<!-- Netlify Identity: carga condicional optimizada.
     Solo descarga el widget (~100KB) si se accede a /admin/ o si la URL
     contiene un token de invitación/recuperación en el hash (#_token=, #recovery_token=, #invite_token=). -->
<script>
  (function() {
    var hash = window.location.hash || '';
    var path = window.location.pathname || '';
    var isAuthRoute = path.indexOf('/admin') === 0;
    var hasAuthToken = hash.indexOf('_token=') !== -1 ||
                       hash.indexOf('recovery_token=') !== -1 ||
                       hash.indexOf('invite_token=') !== -1;

    if (isAuthRoute || hasAuthToken) {
      var script = document.createElement('script');
      script.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
      script.async = true;
      script.onload = function() {
        if (window.netlifyIdentity) {
          window.netlifyIdentity.on('init', function(user) {
            if (!user) {
              window.netlifyIdentity.on('login', function() {
                document.location.href = '/admin/';
              });
            }
          });
        }
      };
      document.head.appendChild(script);
    }
  })();
</script>
