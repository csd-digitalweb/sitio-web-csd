permalink: /admisiones/
---

<main id="top">
  <!-- HERO ADMISIONES -->
  <section class="band band-paper" style="padding-top:48px; padding-bottom:48px;">
    <div class="wrap">
      <div class="section-head reveal in">
        <p class="eyebrow">Admisiones 2026 — 2027</p>
        <h2>Proceso de Inscripción y Matrículas</h2>
        <p>Acompañamos a su hijo desde preescolar hasta once en la misma sede en el Barrio La Cumbre. Conozca los pasos para formar parte de nuestra comunidad educativa.</p>
      </div>
    </div>
  </section>

  <!-- PASOS DE ADMISIÓN -->
  <section class="band band-deep">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Paso a paso</p>
        <h2>¿Cómo inscribirse en el Colegio CSD?</h2>
      </div>
      <div class="admission-steps">
        <div class="step-card reveal">
          <div class="step-number">01</div>
          <h3>Solicitud de cupo</h3>
          <p>Diligencie el formulario de contacto o escríbanos por WhatsApp para verificar la disponibilidad de cupo en el grado requerido.</p>
        </div>
        <div class="step-card reveal">
          <div class="step-number">02</div>
          <h3>Entrevista y valoración</h3>
          <p>Coordinamos una reunión presencial en el colegio con los padres y el estudiante para conocer nuestro modelo académico y de convivencia.</p>
        </div>
        <div class="step-card reveal">
          <div class="step-number">03</div>
          <h3>Entrega de documentos</h3>
          <p>Presentación de certificado de estudios anteriores, paz y salvo, fotocopia de documento de identidad y registro civil.</p>
        </div>
        <div class="step-card reveal">
          <div class="step-number">04</div>
          <h3>Matrícula oficial</h3>
          <p>Firma del contrato de prestación de servicios educativos y formalización de la matrícula para el año lectivo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- REQUISITOS Y NIVELES -->
  <section class="band band-paper">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Niveles educativos</p>
        <h2>Oferta por Grados</h2>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3, 1fr); gap:24px;">
        <div style="background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:26px;" class="reveal">
          <h3 style="color:var(--blue-700); margin-bottom:10px;">Preescolar</h3>
          <p style="font-size:0.92rem; margin-bottom:12px;">Transición y Jardín. Enfoque en desarrollo motriz, valores y primeras nociones de convivencia y exploración científica.</p>
          <span style="font-weight:700; font-size:0.84rem; color:var(--ink);">Edad mínima: 4 - 5 años</span>
        </div>
        <div style="background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:26px;" class="reveal">
          <h3 style="color:var(--blue-700); margin-bottom:10px;">Primaria (1° a 5°)</h3>
          <p style="font-size:0.92rem; margin-bottom:12px;">Bases sólidas en matemáticas, lenguaje e introducción temprana a Física, Química y Filosofía desde los primeros años.</p>
          <span style="font-weight:700; font-size:0.84rem; color:var(--ink);">Grupos reducidos e interactivos</span>
        </div>
        <div style="background:var(--surface); border:1px solid var(--line); border-radius:10px; padding:26px;" class="reveal">
          <h3 style="color:var(--blue-700); margin-bottom:10px;">Bachillerato (6° a 11°)</h3>
          <p style="font-size:0.92rem; margin-bottom:12px;">Profundización científica y académica, preparación intensiva para Pruebas Saber 11 y orientación vocacional.</p>
          <span style="font-weight:700; font-size:0.84rem; color:var(--ink);">Preparación Pruebas Saber</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS FRECUENTES (FAQ) -->
  <section class="band band-deep">
    <div class="wrap" style="max-width:860px;">
      <div class="section-head reveal">
        <p class="eyebrow">Dudas comunes</p>
        <h2>Preguntas Frecuentes de Admisión</h2>
      </div>

      <div class="faq-accordion reveal">
        <div class="faq-item">
          <button class="faq-question">¿Cuál es el horario de clases por jornada?</button>
          <div class="faq-answer">
            <p>Contamos con jornada única matinal para preescolar, primaria y bachillerato, garantizando el cumplimiento de la intensidad horaria académica oficial.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">¿Qué documentos se necesitan para iniciar el proceso?</button>
          <div class="faq-answer">
            <p>Se requiere fotocopia del Registro Civil o Tarjeta de Identidad, boletín del último año cursado, paz y salvo del colegio anterior y certificado de EPS/FOSYGA.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">¿Por qué elegir un colegio de salones pequeños?</button>
          <div class="faq-answer">
            <p>Los grupos reducidos permiten un acompañamiento personalizado donde cada profesor conoce las fortalezas y necesidades individuales de cada estudiante, previniendo el matoneo y fortaleciendo el rendimiento académico.</p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">¿Cómo puedo solicitar información sobre pensiones y costos?</button>
          <div class="faq-answer">
            <p>Puede comunicarse directamente con nuestra secretaría vía WhatsApp o agendar una cita presencial para conocer las tarifas aprobadas por la Secretaría de Educación.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMULARIO DIRECTO -->
  <section class="band band-paper" id="contacto-admisiones">
    <div class="wrap" style="max-width:680px;">
      <div class="section-head reveal" style="text-align:center;">
        <p class="eyebrow">Contacto de Admisiones</p>
        <h2>Solicita tu cita o cupo</h2>
        <p>Déjenos sus datos y nos pondremos en contacto con usted a la brevedad.</p>
      </div>

      <div class="form-card reveal">
        <form action="#" method="POST" onsubmit="alert('¡Gracias por su interés! Nos pondremos en contacto muy pronto.'); return false;">
          <div class="field">
            <label for="nombre">Nombre completo del acudiente *</label>
            <input type="text" id="nombre" name="nombre" required placeholder="Ej. María Rodríguez">
          </div>
          <div class="field">
            <label for="telefono">Teléfono / WhatsApp de contacto *</label>
            <input type="tel" id="telefono" name="telefono" required placeholder="Ej. 300 123 4567">
          </div>
          <div class="field">
            <label for="grado">Grado de interés *</label>
            <input type="text" id="grado" name="grado" required placeholder="Ej. Transición, 3° de Primaria, 9° de Bachillerato">
          </div>
          <div class="field">
            <label for="mensaje">Comentario o pregunta adicional</label>
            <textarea id="mensaje" name="mensaje" placeholder="¿Tiene alguna consulta sobre horarios o requisitos?"></textarea>
          </div>
          <button class="btn btn-primary" type="submit" style="width:100%; margin-top:10px;">Enviar Solicitud de Información</button>
        </form>
      </div>
    </div>
  </section>
</main>
