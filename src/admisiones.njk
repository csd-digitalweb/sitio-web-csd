<script>
let dataAdmisiones = null;

async function cargarDatosAdmision() {
  if (dataAdmisiones) return dataAdmisiones;
  try {
    const res = await fetch('/admisiones/admitidos_hash.json?_t=' + Date.now(), { cache: "no-store" });
    if (res.ok) {
      dataAdmisiones = await res.json();
      return dataAdmisiones;
    }
  } catch (err) {
    console.warn("No se pudo cargar admitidos_hash.json remotamente", err);
  }
  return {};
}

async function sha256Doc(str) {
  const buf = new TextEncoder().encode(str);
  const hashBuf = await crypto.subtle.digest("SHA-256", buf);
  return Array.from(new Uint8Array(hashBuf)).map(b => b.toString(16).padStart(2, "0")).join("");
}

async function consultarAdmision(e) {
  if (e) e.preventDefault();
  const input = document.getElementById('input-doc-admision');
  const doc = input.value.trim().replace(/[^0-9]/g, '');
  const alertaNoAdmitido = document.getElementById('alerta-no-admitido');
  const seccionAdmitido = document.getElementById('seccion-admitido');

  alertaNoAdmitido.style.display = 'none';
  seccionAdmitido.style.display = 'none';

  if (!doc || doc.length < 5) {
    alert("Por favor ingrese un número de documento válido (mínimo 5 dígitos).");
    input.focus();
    return;
  }

  document.getElementById('btn-adm-text').style.display = 'none';
  document.getElementById('btn-adm-spinner').style.display = 'inline-block';
  document.getElementById('btn-consultar-admision').disabled = true;

  try {
    const db = await cargarDatosAdmision();
    const hash = await sha256Doc(doc);
    const estudiante = db[hash];

    // Condición: Existe en base de datos Y tiene un SALÓN asignado (no vacío y no SIN ASIGNAR)
    if (estudiante && estudiante.salon && estudiante.salon !== '' && estudiante.salon !== 'SIN ASIGNAR') {
      // Caso A: ADMITIDO CON SALÓN
      document.getElementById('res-nombre-estudiante').textContent = estudiante.nombre;
      document.getElementById('res-doc-estudiante').textContent = estudiante.doc;
      document.getElementById('res-salon-educolombia').textContent = estudiante.salon;
      document.getElementById('res-grado-2027').textContent = estudiante.grado_2027;
      document.getElementById('res-acudiente').textContent = estudiante.acudiente || 'Acudiente Registrado';
      document.getElementById('res-doc-acudiente').textContent = estudiante.doc_acudiente || 'C.C. Registrada';

      const apellidos = estudiante.nombre.split(' ');
      const fam = apellidos.length >= 3 ? apellidos.slice(2).join(' ') : apellidos.join(' ');
      document.getElementById('est-apellido-familia').textContent = fam;

      // Actualizar enlace directo a WhatsApp de Tesorería
      const wspMsg = encodeURIComponent('Hola Tesorería CSD, adjunto comprobante de pago de matrícula 2027 del estudiante nuevo admitido ' + estudiante.nombre + ' (Doc: ' + estudiante.doc + ').');
      document.getElementById('btn-wsp-tesoreria').href = 'https://wa.me/573218903190?text=' + wspMsg;

      seccionAdmitido.style.display = 'block';
      cambiarTabAdmision(1);
      seccionAdmitido.scrollIntoView({ behavior: 'smooth' });
    } else {
      // Caso B: NO ADMITIDO O SIN SALÓN EN EDUCOLOMBIA
      document.getElementById('doc-consultado-no-admitido').textContent = doc;
      const wspSecMsg = encodeURIComponent('Hola Secretaría CSD, quisiera consultar el estado de admisión para el documento ' + doc + ' ya que no registra salón asignado.');
      document.getElementById('btn-wsp-secretaria').href = 'https://wa.me/573152904403?text=' + wspSecMsg;

      alertaNoAdmitido.style.display = 'block';
      alertaNoAdmitido.scrollIntoView({ behavior: 'smooth' });
    }
  } catch (err) {
    console.error(err);
    alert("Ocurrió un inconveniente al consultar la admisión. Por favor intente nuevamente.");
  } finally {
    document.getElementById('btn-adm-text').style.display = 'inline-block';
    document.getElementById('btn-adm-spinner').style.display = 'none';
    document.getElementById('btn-consultar-admision').disabled = false;
  }
}

function probarDocAdmision(num) {
  const input = document.getElementById('input-doc-admision');
  input.value = num;
  consultarAdmision();
}

function reiniciarConsultaAdmision() {
  const input = document.getElementById('input-doc-admision');
  input.value = '';
  document.getElementById('alerta-no-admitido').style.display = 'none';
  document.getElementById('seccion-admitido').style.display = 'none';
  input.focus();
}

function cambiarTabAdmision(num) {
  for (let i = 1; i <= 3; i++) {
    const tabBtn = document.getElementById('adm-tab-btn-' + i);
    const tabContent = document.getElementById('adm-tab-content-' + i);
    if (tabBtn && tabContent) {
      if (i === num) {
        tabBtn.style.color = '#003865';
        tabBtn.style.borderBottomColor = '#003865';
        tabBtn.style.background = 'rgba(0, 56, 101, 0.05)';
        tabContent.style.display = 'block';
      } else {
        tabBtn.style.color = '#64748B';
        tabBtn.style.borderBottomColor = 'transparent';
        tabBtn.style.background = 'transparent';
        tabContent.style.display = 'none';
      }
    }
  }
}

function copiarTexto(texto, btn) {
  navigator.clipboard.writeText(texto).then(() => {
    const originalText = btn.innerHTML;
    btn.innerHTML = '✅ ¡Copiado!';
    btn.style.background = '#BBF7D0';
    btn.style.color = '#166534';
    setTimeout(() => {
      btn.innerHTML = originalText;
      btn.style.background = '';
      btn.style.color = '';
    }, 2000);
  });
}

document.addEventListener("DOMContentLoaded", () => {
  cargarDatosAdmision();
});
</script>

