<!-- Script de Validación e Interactividad del Formulario -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var form = document.getElementById('contact-form');
    var feedback = document.getElementById('form-feedback');
    var btnSubmit = document.getElementById('btn-submit-form');
    if (!form || !feedback || !btnSubmit) return;

    var inputNombre = document.getElementById('nombre');
    var inputCorreo = document.getElementById('correo');
    var inputMensaje = document.getElementById('mensaje');

    var fieldNombre = document.getElementById('field-nombre');
    var fieldCorreo = document.getElementById('field-correo');
    var fieldMensaje = document.getElementById('field-mensaje');

    var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function clearError(field) {
      if (field) field.classList.remove('has-error');
    }

    function setError(field) {
      if (field) field.classList.add('has-error');
    }

    // Limpieza en tiempo real al escribir
    if (inputNombre) inputNombre.addEventListener('input', function() { clearError(fieldNombre); });
    if (inputCorreo) inputCorreo.addEventListener('input', function() { clearError(fieldCorreo); });
    if (inputMensaje) inputMensaje.addEventListener('input', function() { clearError(fieldMensaje); });

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var isValid = true;
      var firstInvalidField = null;

      // Validación Nombre
      if (!inputNombre || inputNombre.value.trim().length < 2) {
        setError(fieldNombre);
        isValid = false;
        if (!firstInvalidField) firstInvalidField = inputNombre;
      } else {
        clearError(fieldNombre);
      }

      // Validación Correo
      if (!inputCorreo || !emailRegex.test(inputCorreo.value.trim())) {
        setError(fieldCorreo);
        isValid = false;
        if (!firstInvalidField) firstInvalidField = inputCorreo;
      } else {
        clearError(fieldCorreo);
      }

      // Validación Mensaje
      if (!inputMensaje || inputMensaje.value.trim().length < 10) {
        setError(fieldMensaje);
        isValid = false;
        if (!firstInvalidField) firstInvalidField = inputMensaje;
      } else {
        clearError(fieldMensaje);
      }

      if (!isValid) {
        if (firstInvalidField) firstInvalidField.focus();
        return;
      }

      // Estado de envío simulado
      btnSubmit.disabled = true;
      btnSubmit.style.opacity = '0.75';
      var originalBtnHtml = btnSubmit.innerHTML;
      btnSubmit.innerHTML = '<span>Enviando mensaje...</span>';

      setTimeout(function() {
        // Feedback de éxito
        feedback.className = 'form-feedback success';
        feedback.innerHTML = '<span class="feedback-icon">✓</span><div><strong>¡Mensaje recibido!</strong><br/>Nos pondremos en contacto contigo muy pronto al correo proporcionado.</div>';
        feedback.style.display = 'flex';
        feedback.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        // Resetear formulario
        form.reset();
        btnSubmit.disabled = false;
        btnSubmit.style.opacity = '1';
        btnSubmit.innerHTML = originalBtnHtml;
      }, 450);
    });
  });
</script>
