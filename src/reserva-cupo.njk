            <h3>📅 Importancia de la Reserva a Tiempo</h3>
            <p>Mantener grupos pequeños con atención personalizada requiere planificar con precisión los cupos de cada aula en la Sede La Cumbre.</p>
            <ul class="check-list" style="margin-top:12px; padding:0; list-style:none; display:flex; flex-direction:column; gap:8px; font-size:0.9rem;">
              <li>✅ Garantizas el lugar de tu hijo en su grupo habitual.</li>
              <li>✅ Facilitas la organización del material pedagógico.</li>
              <li>✅ Recibes prioridad en la entrega de circulares.</li>
            </ul>
          </div>

          <div class="sidebar-card highlight">
            <h3>💬 ¿Dudas con tu proceso?</h3>
            <p>Si tienes alguna consulta sobre la continuidad o los costos para el próximo año, escríbenos directamente por WhatsApp.</p>
            <a class="btn btn-outline" href="https://wa.me/573152904403?text=Hola%20Colegio%20CSD,%20quisiera%20consultar%20sobre%20la%20reserva%20de%20cupo%20de%20mi%20hijo" target="_blank" rel="noopener" style="width:100%; justify-content:center; margin-top:14px;">
              Contactar a Secretaría en WhatsApp
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>
</main>

<script>
let dataPrematriculas = null;

async function cargarDatos(forceRefresh = false) {
  if (dataPrematriculas && !forceRefresh) return dataPrematriculas;
  if (window.DATA_PREMATRICULAS && !forceRefresh) {
    dataPrematriculas = window.DATA_PREMATRICULAS;
    return dataPrematriculas;
  }
  const cacheBuster = "?_t=" + Date.now();
  const paths = [
    "/reserva-cupo/prematriculas_hash.json" + cacheBuster,
    "./prematriculas_hash.json" + cacheBuster,
    "/prematriculas_hash.json" + cacheBuster
  ];
  for (const path of paths) {
    try {
      const res = await fetch(path, { cache: "no-store" });
      if (res.ok) {
        dataPrematriculas = await res.json();
        return dataPrematriculas;
      }
    } catch (e) {}
  }
  return {};
}

async function sha256(str) {
  const buf = new TextEncoder().encode(str);
  const hashBuf = await crypto.subtle.digest("SHA-256", buf);
  return Array.from(new Uint8Array(hashBuf)).map(b => b.toString(16).padStart(2, "0")).join("");
}

async function consultarPin(e) {
  if (e) e.preventDefault();
  const input = document.getElementById("doc-estudiante");
  const doc = input.value.trim();

  if (!doc || doc.length < 5) {
    alert("Por favor ingresa un número de documento válido (mínimo 5 dígitos).");
    input.focus();
    return;
  }

  document.getElementById("btn-text").style.display = "none";
  document.getElementById("btn-spinner").style.display = "inline-block";
  document.getElementById("btn-consultar").disabled = true;

  document.getElementById("resultado-promovido").style.display = "none";
  document.getElementById("resultado-espera-notas").style.display = "none";
  document.getElementById("resultado-sin-apartar").style.display = "none";
  document.getElementById("resultado-error").style.display = "none";

  try {
    const db = await cargarDatos(true);
    const hash = await sha256(doc);
    const alumno = db[hash];

    if (alumno && alumno.pin) {
      // Formatear nombre limpio y familia
      let nombreLimpio = (alumno.nombre || "").replace(/[-_]/g, ' ').replace(/\s+/g, ' ').trim();
      nombreLimpio = nombreLimpio.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      
      const partes = nombreLimpio.split(' ');
      const fam = partes.length >= 2 ? partes.slice(0, 2).join(' ') : partes[0];
      const primerNom = partes.length >= 3 ? partes.slice(2).join(' ') : nombreLimpio;

      const gradoActual = alumno.grado || '-';
      const gradoRecibe = alumno.grado_siguiente || alumno.grado || '-';

      const estadoPremat = (alumno.estado || "").toLowerCase();
      const haApartadoCupo = (estadoPremat.includes("sigue") || estadoPremat.includes("confirmad")) && !estadoPremat.includes("sin");

      // REGLA 1: Si el estudiante NO ha apartado el cupo todavía:
      // Debe apartar el cupo para continuar con el proceso.
      if (!haApartadoCupo) {
        // CASO C: SIN APARTAR CUPO
        document.getElementById("sin-apartar-familia").textContent = fam;
        document.getElementById("sin-apartar-estudiante-nom").textContent = nombreLimpio;
        document.getElementById("sin-apartar-nombre").textContent = nombreLimpio;
        document.getElementById("sin-apartar-doc").textContent = alumno.doc || doc;
        document.getElementById("sin-apartar-grado").textContent = gradoActual;
        document.getElementById("sin-apartar-grado-recibe").textContent = gradoRecibe;
        document.getElementById("sin-apartar-pin").textContent = alumno.pin;
        document.getElementById("sin-apartar-hidden-pin").value = alumno.pin;

        document.getElementById("resultado-sin-apartar").style.display = "block";
        document.getElementById("resultado-sin-apartar").scrollIntoView({ behavior: 'smooth' });
      } 
      // REGLA 2: El mensaje de cierre académico o promoción SOLO debe salirle a quien ya apartó el cupo:
      else if (alumno.promovido === 1 || alumno.promovido === "1" || alumno.promovido === true) {
        // CASO A: CUPO APARTADO + PROMOVIDO AL SIGUIENTE GRADO
        document.getElementById("prom-nombre").textContent = nombreLimpio;
        document.getElementById("prom-nombre-saludo").textContent = primerNom;
        document.getElementById("prom-doc").textContent = alumno.doc || doc.replace('_prom', '');
        document.getElementById("prom-grado-anterior").textContent = gradoActual;
        document.getElementById("prom-grado-recibe").textContent = gradoRecibe;
        document.getElementById("prom-grado-siguiente").textContent = gradoRecibe;
        document.getElementById("prom-pin").textContent = alumno.pin;
        document.getElementById("prom-hidden-pin").value = alumno.pin;

        document.getElementById("resultado-promovido").style.display = "block";
        document.getElementById("resultado-promovido").scrollIntoView({ behavior: 'smooth' });
      } else {
        // CASO B: CUPO APARTADO + NOTAS EN CIERRE / EN ESPERA HASTA EL 20 DE NOVIEMBRE
        document.getElementById("espera-familia").textContent = fam;
        document.getElementById("espera-nombre").textContent = nombreLimpio;
        document.getElementById("espera-grado").textContent = gradoActual;
        document.getElementById("espera-grado-siguiente").textContent = gradoRecibe;
        document.getElementById("espera-pin").textContent = alumno.pin;

        document.getElementById("resultado-espera-notas").style.display = "block";
        document.getElementById("resultado-espera-notas").scrollIntoView({ behavior: 'smooth' });
      }

      document.getElementById("form-consulta-pin").style.display = "none";
    } else {
      document.getElementById("doc-erroneo").textContent = doc;
      document.getElementById("resultado-error").style.display = "block";
      document.getElementById("resultado-error").scrollIntoView({ behavior: 'smooth' });
    }
  } catch (err) {
    console.error(err);
    alert("Ocurrió un inconveniente al consultar el PIN. Por favor intenta de nuevo.");
  } finally {
    document.getElementById("btn-text").style.display = "inline-block";
    document.getElementById("btn-spinner").style.display = "none";
    document.getElementById("btn-consultar").disabled = false;
  }
}

function probarDocPremat(docNum) {
  const input = document.getElementById("doc-estudiante");
  input.value = docNum;
  consultarPin();
}

function copiarPin(elementId, btn) {
  const pinText = document.getElementById(elementId).textContent.trim();
  navigator.clipboard.writeText(pinText).then(() => {
    const originalText = btn.innerHTML;
    btn.innerHTML = '✅ ¡Copiado!';
    btn.style.background = '#BBF7D0';
    btn.style.color = '#166534';
    setTimeout(() => {
      btn.innerHTML = originalText;
      btn.style.background = '';
      btn.style.color = '';
    }, 2000);
  });
}

function reiniciarConsulta() {
  document.getElementById("resultado-promovido").style.display = "none";
  document.getElementById("resultado-espera-notas").style.display = "none";
  document.getElementById("resultado-sin-apartar").style.display = "none";
  document.getElementById("resultado-error").style.display = "none";
  document.getElementById("form-consulta-pin").style.display = "block";
  const input = document.getElementById("doc-estudiante");
  input.value = "";
  input.focus();
}

document.addEventListener("DOMContentLoaded", () => {
  cargarDatos();
});
</script>
