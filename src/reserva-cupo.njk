</main>

<script>
function handleReservaCupo(e) {
  e.preventDefault();
  const nombre = document.getElementById('res-estudiante-nombre').value;
  const grado = document.getElementById('res-grado-actual').value;
  const acudiente = document.getElementById('res-acudiente-nombre').value;
  const tel = document.getElementById('res-acudiente-tel').value;
  const confirmacion = document.getElementById('res-confirmacion').value;
  const obs = document.getElementById('res-observaciones').value;

  const data = {
    fecha: new Date().toISOString(),
    estudiante: nombre,
    grado: grado,
    acudiente: acudiente,
    telefono: tel,
    confirmacion: confirmacion,
    observaciones: obs
  };

  // Guardar en almacenamiento local/servidor y notificar al sistema de reportes
  try {
    let reservas = JSON.parse(localStorage.getItem('csd_reservas_cupo') || '[]');
    reservas.push(data);
    localStorage.setItem('csd_reservas_cupo', JSON.stringify(reservas));
  } catch(err){}

  document.getElementById('form-cupos').style.display = 'none';
  document.getElementById('reserva-success-msg').style.display = 'block';
}
</script>
