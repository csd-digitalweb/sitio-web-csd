                <rect y="7" width="32" height="6" fill="#FACC15"/>
                <rect y="13" width="32" height="7" fill="#2563EB"/>
                <line x1="0" y1="0" x2="0" y2="35" stroke="#000" stroke-width="2.5"/>
              </g>
              <g transform="translate(325, 45) rotate(12)">
