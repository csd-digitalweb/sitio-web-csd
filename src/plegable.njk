            </svg>

            <!-- Comic Floating Star Stickers -->
            <div class="absolute top-2 right-2 bg-comic-yellow text-black font-comic px-2 py-0.5 rounded border-2 border-black transform rotate-6 shadow-comic-sm text-xs">
