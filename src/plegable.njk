              <rect x="175" y="58" width="22" height="15" rx="4" fill="#FACC15" stroke="#000" stroke-width="2"/>
              <rect x="203" y="58" width="22" height="15" rx="4" fill="#FACC15" stroke="#000" stroke-width="2"/>
