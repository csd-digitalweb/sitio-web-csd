<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Semana Cultural 2026 - Plegable Interactivo CSD</title>
  
  <!-- Comic & Display Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Fredoka:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            comic: {
              yellow: '#FACC15',
              darkYellow: '#EAB308',
              navy: '#0F172A',
              cardNavy: '#1E293B',
              red: '#EF4444',
              brightRed: '#DC2626',
              blue: '#0284C7',
              sky: '#38BDF8',
              green: '#10B981',
              emerald: '#059669',
              orange: '#F97316',
              purple: '#A855F7'
            }
          },
          fontFamily: {
            comic: ['"Bangers"', 'cursive', 'sans-serif'],
            fun: ['"Fredoka"', 'sans-serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif']
          },
          boxShadow: {
            'comic': '4px 4px 0px #000000',
            'comic-lg': '6px 6px 0px #000000',
            'comic-sm': '2px 2px 0px #000000',
            'comic-inset': 'inset 3px 3px 0px rgba(255,255,255,0.2)'
          }
        }
      }
    }
  </script>

  <style>
    /* Halftone dot pattern typical in comics */
    .comic-dots {
      background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1.5px, transparent 1.5px);
      background-size: 14px 14px;
    }
    .comic-dots-dark {
      background-image: radial-gradient(rgba(0, 0, 0, 0.15) 1.5px, transparent 1.5px);
      background-size: 12px 12px;
    }
    
    /* Pop sticker animation */
    .comic-pop {
      animation: comicPopAnim 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
    @keyframes comicPopAnim {
      0% { transform: scale(0.6) rotate(-8deg); opacity: 0; }
      100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    /* Comic sound blast effect */
    .sound-badge {
      display: inline-block;
      transform: rotate(-6deg);
      text-shadow: 2px 2px 0px #000;
    }

    /* Custom comic scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #facc15;
      border: 2px solid #000;
      border-radius: 9999px;
    }

    /* Pulsing cartoon glow */
    .lantern-glow {
      filter: drop-shadow(0 0 12px rgba(250, 204, 21, 0.7));
    }

    /* Pulse for music button when playing */
    .music-pulse {
      animation: pulseMusic 1.5s infinite;
    }
    @keyframes pulseMusic {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(250, 204, 21, 0.7); }
      50% { transform: scale(1.08); box-shadow: 0 0 0 8px rgba(250, 204, 21, 0); }
    }
  </style>
</head>

<body class="bg-slate-950 text-slate-100 flex flex-col items-center justify-center min-h-screen font-fun selection:bg-comic-yellow selection:text-slate-950 p-0 sm:p-4">

  <!-- Audio Element: Canción Oficial Festival Edit -->
  <audio id="bg-music" loop preload="auto">
    <source src="/assets/audio/cancion_semana_cultural_festival_edit.mp3" type="audio/mpeg">
  </audio>

  <!-- Mobile Simulator Phone Container (1080x1920 ratio style) -->
  <main class="w-full max-w-[460px] h-[100dvh] sm:h-[880px] sm:max-h-[94vh] bg-comic-navy flex flex-col overflow-hidden sm:rounded-[36px] shadow-[0_25px_60px_rgba(0,0,0,0.9)] border-0 sm:border-8 sm:border-black relative">
    
    <!-- TOP COMIC BANNER & STATUS -->
    <header class="bg-comic-yellow text-slate-950 border-b-4 border-black px-3 py-2 flex items-center justify-between z-30 select-none shadow-comic-sm">
      <div class="flex items-center gap-1.5">
        <img src="/assets/logo.png" alt="Logo CSD" class="h-6 w-auto object-contain inline-block">
        <span class="font-comic text-base sm:text-lg tracking-wider uppercase text-black leading-none pt-0.5">PASAPORTE CULTURAL 2026</span>
      </div>
      <div class="flex items-center gap-2">
        <!-- Stamp collection popup trigger -->
        <button id="btn-open-stamps" class="bg-white hover:bg-slate-100 text-black border-2 border-black px-2 py-0.5 rounded-lg text-xs font-bold font-comic tracking-wide shadow-comic-sm flex items-center gap-1 transition active:translate-y-0.5">
          <i class="fa-solid fa-stamp text-comic-red"></i>
          <span id="header-stamp-count">SELLOS: 1/8</span>
        </button>
        <!-- Audio toggle -->
        <button onclick="toggleAudio()" id="btn-audio-toggle" title="Reproducir música de la Semana Cultural" class="bg-black text-comic-yellow px-2 py-1 rounded-lg flex items-center gap-1 text-xs border border-yellow-400 cursor-pointer shadow-comic-sm">
          <i id="audio-icon" class="fa-solid fa-play text-comic-yellow"></i>
          <span id="audio-label" class="font-comic text-[10px] hidden xs:inline">MÚSICA</span>
        </button>
      </div>
    </header>

    <!-- SLIDE VIEWPORT (9 Dedicated Screens) -->
