      <!-- ========================================================
           PANTALLA 1: PORTADA CÓMIC (BANNER PRINCIPAL)
           ======================================================== -->
      <section id="slide-1" class="slide-screen p-4 flex flex-col justify-between min-h-full comic-pop">
