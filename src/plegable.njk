    <div id="gallery-modal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 hidden flex flex-col justify-between p-4">
      <div class="flex items-center justify-between border-b-2 border-black pb-2 bg-comic-yellow -mx-4 -mt-4 p-4 shadow-comic-sm">
        <div class="flex items-center gap-2">
          <span class="text-2xl">📸</span>
          <h3 class="font-comic text-lg text-black">GALERÍA DE RECUERDOS DEL MUNDIAL</h3>
        </div>
        <button onclick="closeGalleryModal()" class="text-black hover:text-comic-red text-2xl font-bold">
          <i class="fa-solid fa-circle-xmark"></i>
        </button>
      </div>

      <div class="grid grid-cols-2 gap-2 overflow-y-auto py-3 max-h-[70vh]">
        <div class="bg-comic-cardNavy p-1.5 rounded-xl border-2 border-black shadow-comic-sm space-y-1">
          <img src="https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=400&q=80" class="rounded-lg h-24 w-full object-cover border border-black" alt="Juegos">
          <p class="font-comic text-[10px] text-comic-yellow text-center">JUEGOS TRADICIONALES</p>
        </div>
        <div class="bg-comic-cardNavy p-1.5 rounded-xl border-2 border-black shadow-comic-sm space-y-1">
          <img src="https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=400&q=80" class="rounded-lg h-24 w-full object-cover border border-black" alt="Trivia">
          <p class="font-comic text-[10px] text-comic-sky text-center">DESAFÍO AL SABER</p>
        </div>
        <div class="bg-comic-cardNavy p-1.5 rounded-xl border-2 border-black shadow-comic-sm space-y-1">
          <img src="https://images.unsplash.com/photo-1508098682722-e99c43a406b2?auto=format&fit=crop&w=400&q=80" class="rounded-lg h-24 w-full object-cover border border-black" alt="Fútbol">
          <p class="font-comic text-[10px] text-comic-red text-center">MUNDIALITO ESCOLAR</p>
        </div>
        <div class="bg-comic-cardNavy p-1.5 rounded-xl border-2 border-black shadow-comic-sm space-y-1">
          <img src="https://images.unsplash.com/photo-1593113598332-cd288d649433?auto=format&fit=crop&w=400&q=80" class="rounded-lg h-24 w-full object-cover border border-black" alt="Acción Social">
          <p class="font-comic text-[10px] text-comic-green text-center">ACCIÓN SOCIAL</p>
        </div>
        <div class="bg-comic-cardNavy p-1.5 rounded-xl border-2 border-black shadow-comic-sm space-y-1">
          <img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=400&q=80" class="rounded-lg h-24 w-full object-cover border border-black" alt="Gastronomía">
          <p class="font-comic text-[10px] text-comic-purple text-center">FERIA DE GASTRONOMÍA</p>
        </div>
        <div class="bg-comic-cardNavy p-1.5 rounded-xl border-2 border-black shadow-comic-sm space-y-1">
          <img src="https://images.unsplash.com/photo-1514565131-fce0801e5785?auto=format&fit=crop&w=400&q=80" class="rounded-lg h-24 w-full object-cover border border-black" alt="Faroles">
          <p class="font-comic text-[10px] text-comic-yellow text-center">NOCHE DE FAROLES</p>
        </div>
      </div>

      <div class="text-center pt-2">
        <button onclick="closeGalleryModal()" class="w-full bg-comic-yellow hover:bg-comic-darkYellow text-slate-950 font-comic py-2.5 rounded-xl border-2 border-black shadow-comic text-sm">
          VOLVER AL FOLLETO CÓMIC
        </button>
      </div>
    </div>

  </main>

  <!-- ========================================================
       JAVASCRIPT LOGIC: NAVEGACIÓN, SELLOS, SONIDOS Y EVENTOS
       ======================================================== -->
  <script>
    let currentSlide = 1;
    const totalSlides = 9;
    let isMusicPlaying = false;

    const bgAudio = document.getElementById('bg-music');

    // Stamp names and statuses
    const stampsData = [
      { id: 0, name: "Entrada Oficial", icon: "🛂", slide: 1, collected: true },
      { id: 1, name: "Visado Bienvenida", icon: "✈️", slide: 2, collected: false },
      { id: 2, name: "Juegos Tradicionales", icon: "🎲", slide: 3, collected: false },
      { id: 3, name: "Desafío al Saber", icon: "🧠", slide: 4, collected: false },
      { id: 4, name: "Mundialito Escolar", icon: "⚽", slide: 5, collected: false },
      { id: 5, name: "Acción Social", icon: "🤝", slide: 6, collected: false },
      { id: 6, name: "Ciencia & Arte", icon: "🔬", slide: 7, collected: false },
      { id: 7, name: "Noche de Faroles", icon: "🏮", slide: 8, collected: false }
    ];

    // Sound Synthesizer via Tone.js
    let synth = null;
    function playComicSound(type = "stamp") {
      try {
        if (!synth && window.Tone) {
          synth = new Tone.PolySynth(Tone.Synth).toDestination();
          synth.volume.value = -7;
        }
        if (window.Tone && Tone.context.state !== 'running') {
          Tone.start();
        }
        if (synth) {
          if (type === "stamp") {
            synth.triggerAttackRelease(["C5", "G5"], "16n");
          } else if (type === "page") {
            synth.triggerAttackRelease(["F4"], "32n");
          } else if (type === "complete") {
            synth.triggerAttackRelease(["C5", "E5", "G5", "C6"], "8n");
          }
        }
      } catch (err) {}
    }

    // Toggle Background Music
    function toggleAudio() {
      const btn = document.getElementById('btn-audio-toggle');
      const icon = document.getElementById('audio-icon');
      const label = document.getElementById('audio-label');

      if (!isMusicPlaying) {
        bgAudio.play().then(() => {
          isMusicPlaying = true;
          if (icon) icon.className = "fa-solid fa-volume-high text-black";
          if (label) label.innerText = "SONANDO";
          if (btn) {
            btn.className = "bg-comic-yellow text-slate-950 px-2 py-1 rounded-lg flex items-center gap-1 text-xs border-2 border-black cursor-pointer shadow-comic-sm music-pulse";
          }
        }).catch(err => {
          console.log("Audio play error:", err);
        });
      } else {
        bgAudio.pause();
        isMusicPlaying = false;
        if (icon) icon.className = "fa-solid fa-play text-comic-yellow";
        if (label) label.innerText = "MÚSICA";
        if (btn) {
          btn.className = "bg-black text-comic-yellow px-2 py-1 rounded-lg flex items-center gap-1 text-xs border border-yellow-400 cursor-pointer shadow-comic-sm";
        }
      }
    }

    // Attempt to start music on first user click if not playing
    function tryStartMusicOnInteraction() {
      if (!isMusicPlaying && bgAudio) {
        bgAudio.play().then(() => {
          isMusicPlaying = true;
          const btn = document.getElementById('btn-audio-toggle');
          const icon = document.getElementById('audio-icon');
          const label = document.getElementById('audio-label');
          if (icon) icon.className = "fa-solid fa-volume-high text-black";
          if (label) label.innerText = "SONANDO";
          if (btn) {
            btn.className = "bg-comic-yellow text-slate-950 px-2 py-1 rounded-lg flex items-center gap-1 text-xs border-2 border-black cursor-pointer shadow-comic-sm music-pulse";
          }
        }).catch(() => {});
      }
    }

    // Go to designated Slide (1 to 9)
    function goToSlide(slideNum) {
      if (slideNum < 1 || slideNum > totalSlides) return;
      tryStartMusicOnInteraction();

      // Hide all slides
      for (let i = 1; i <= totalSlides; i++) {
        const s = document.getElementById(`slide-${i}`);
        if (s) s.classList.add('hidden');
        
        const d = document.getElementById(`dock-${i}`);
        if (d) {
          d.className = "dock-btn px-2 py-1 rounded text-slate-400 hover:text-white flex flex-col items-center gap-0.5";
        }
      }

      // Show current slide
      const target = document.getElementById(`slide-${slideNum}`);
      if (target) {
        target.classList.remove('hidden');
        target.classList.remove('comic-pop');
        void target.offsetWidth; // Trigger reflow for animation
        target.classList.add('comic-pop');
      }

      // Highlight dock button
      const activeDock = document.getElementById(`dock-${slideNum}`);
      if (activeDock) {
        activeDock.className = "dock-btn px-2 py-1 rounded bg-comic-yellow text-slate-950 flex flex-col items-center gap-0.5 shadow-comic-sm";
      }

      currentSlide = slideNum;
      playComicSound("page");

      // Auto-collect stamp for corresponding day/slide
      const stampMatch = stampsData.find(st => st.slide === slideNum);
      if (stampMatch && !stampMatch.collected) {
        stampPassport(stampMatch.id, stampMatch.name, false);
      }

      // Reset scroll
      const viewport = document.getElementById('slide-viewport');
      if (viewport) viewport.scrollTop = 0;
    }

    // Passport stamping logic
    function stampPassport(stampId, stampName, manualClick = true) {
      tryStartMusicOnInteraction();
      if (stampId >= 0 && stampId < stampsData.length) {
        stampsData[stampId].collected = true;

        const ind = document.getElementById(`stamp-indicator-${stampId}`);
        const lbl = document.getElementById(`stamp-label-${stampId}`);

        if (ind) {
          ind.innerHTML = "✓";
          ind.classList.remove('text-comic-yellow', 'text-sky-400', 'text-amber-400', 'text-comic-sky', 'text-comic-red', 'text-comic-green', 'text-comic-purple');
          ind.classList.add('bg-emerald-500', 'text-black', 'border-black');
        }
        if (lbl) {
          lbl.innerText = "¡SELLADO CON ÉXITO!";
          lbl.classList.remove('text-comic-yellow', 'text-sky-400', 'text-amber-400', 'text-comic-sky', 'text-comic-red', 'text-comic-green', 'text-comic-purple');
          lbl.classList.add('text-emerald-400', 'font-bold');
        }

        updateHeaderStamps();
        if (manualClick) {
          playComicSound("stamp");
        }
      }
    }

    function updateHeaderStamps() {
      const collected = stampsData.filter(s => s.collected).length;
      document.getElementById('header-stamp-count').innerText = `SELLOS: ${collected}/${stampsData.length}`;
      if (collected === stampsData.length) {
        playComicSound("complete");
      }
    }

    // Stamps Modal
    document.getElementById('btn-open-stamps').addEventListener('click', () => {
      const grid = document.getElementById('passport-grid');
      grid.innerHTML = '';

      stampsData.forEach(s => {
        const item = document.createElement('div');
        item.className = `p-2 rounded-xl border-2 border-black flex flex-col items-center justify-center ${s.collected ? 'bg-comic-yellow text-slate-950 shadow-comic-sm' : 'bg-slate-900 text-slate-500'}`;
        item.innerHTML = `
          <span class="text-2xl">${s.collected ? s.icon : '🔒'}</span>
          <p class="font-comic text-[11px] mt-1">${s.name}</p>
          <span class="text-[9px] font-bold ${s.collected ? 'text-black' : 'text-slate-600'}">${s.collected ? '¡SELLADO!' : 'POR VISITAR'}</span>
        `;
        grid.appendChild(item);
      });

      document.getElementById('stamps-modal').classList.remove('hidden');
      playComicSound("page");
    });

    function closeStampsModal() {
      document.getElementById('stamps-modal').classList.add('hidden');
    }

    // Axis preview modal
    function previewAxis(title, desc, icon) {
      document.getElementById('axis-modal-title').innerText = title;
      document.getElementById('axis-modal-desc').innerText = desc;
      document.getElementById('axis-modal-icon').innerText = icon;
      document.getElementById('axis-modal').classList.remove('hidden');
      playComicSound("page");
    }
    function closeAxisModal() {
      document.getElementById('axis-modal').classList.add('hidden');
    }

    // Gallery Modal
    function openGalleryModal() {
      document.getElementById('gallery-modal').classList.remove('hidden');
      playComicSound("page");
    }
    function closeGalleryModal() {
      document.getElementById('gallery-modal').classList.add('hidden');
    }

    // Keyboard Arrow navigation
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        goToSlide(Math.min(currentSlide + 1, totalSlides));
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        goToSlide(Math.max(currentSlide - 1, 1));
      }
    });

    // Touch Swipe Gestures
    let touchStartX = 0;
    let touchEndX = 0;
    const vp = document.getElementById('slide-viewport');

    vp.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    vp.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (diff < -50) {
        goToSlide(Math.min(currentSlide + 1, totalSlides));
      } else if (diff > 50) {
        goToSlide(Math.max(currentSlide - 1, 1));
      }
    }, { passive: true });

    window.onload = function() {
      updateHeaderStamps();
    };
  </script>
</body>
</html>
